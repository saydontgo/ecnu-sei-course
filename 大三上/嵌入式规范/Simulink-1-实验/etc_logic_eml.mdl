      <P Name="TLCFile">extended_custcode</P>
      <P Name="Location">Subsystem Initialize Function</P>
      <P Name="Middle">/*                                                              
 * QADC Module A                                                
 * Configure the Command Configuration Word For Channels 0     3
 */                                                             
    QADC_A.CCW[0].R=0xC0;                                       
    QADC_A.CCW[1].R=0xC3;                                       
/* Software triggered continuous scan mode */                   
QADC_A.QACR1.B.MQ1 = 0x11;                                      
/* Configure the number of channels in queue 1 */               
QADC_A.QACR2.B.BQ2 = 2;                                         
</P>
