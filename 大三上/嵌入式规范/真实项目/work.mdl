<?xml version="1.0" encoding="utf-8"?>
<chart id="28">
  <P Name="name">Subsystem3-1/StateFunction</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">28</P>
  <P Name="ssIdHighWaterMark">6</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">2</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">calcSystemMode</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">28</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function mode = calcSystemMode(rollRate, onOffPressed)
    % 定义枚举值
    OFF = 0;
    NOMINAL = 1;
    FAILSOFT = 2;
    persistent preonOffPressed;
    persistent prevMode;
    persistent systemState;
    %定义阈值常量
    kFailSoftRoll = 20;
    %定义上升沿改变系统状态


    if isempty(prevMode)  % 第一个周期初始化为OFF状态
        prevMode = OFF;
        preonOffPressed = onOffPressed;
         mode = OFF;
        systemState = false;
        return;
    end
    if(preonOffPressed == 0 &amp;&amp;  onOffPressed == 1)
        systemState = ~systemState;
    end
    mode = prevMode;
    %OFF状态判断
    if((prevMode == NOMINAL ||prevMode ==FAILSOFT) &amp;&amp;~systemState)
        mode = OFF;
    end

    %NOMINAL状态判断
    if(prevMode == OFF &amp;&amp; systemState &amp;&amp; abs(rollRate)&lt;=kFailSoftRoll)
        mode = NOMINAL;
    end
    if(prevMode == FAILSOFT &amp;&amp; abs(rollRate)&lt;=kFailSoftRoll)
        mode = NOMINAL;
    end

    %FAILSOFT状态判断
    if(prevMode == OFF &amp;&amp; systemState &amp;&amp; abs(rollRate)&gt;kFailSoftRoll)
        mode = FAILSOFT;
    end

    if(prevMode == NOMINAL&amp;&amp; abs(rollRate)&gt;kFailSoftRoll)
        mode = FAILSOFT;
    end
    preonOffPressed = onOffPressed;
    prevMode = mode;
end
</P>
      </eml>
    </state>
